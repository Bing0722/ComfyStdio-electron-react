{
  "name": "comfystdio-electron-react",
  "version": "0.8.11",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && electron-vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "package:win": "pnpm run build && electron-builder --win zip --x64 --publish never",
    "package:dir": "pnpm run build && electron-builder --dir --publish never",
    "package": "pnpm run build && electron-builder --publish never"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "motion": "^14.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  },
  "description": "Portable ComfyUI desktop manager",
  "author": "ComfyStdio contributors",
  "build": {
    "appId": "com.bing.comfystdio",
    "productName": "ComfyStdio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "PORTABLE.md",
        "to": "PORTABLE.md"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "ComfyStdio-${version}-win32-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "identity": null,
      "artifactName": "ComfyStdio-${version}-darwin-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "zip"
      ],
      "category": "Graphics",
      "artifactName": "ComfyStdio-${version}-linux-${arch}.${ext}"
    }
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
